SECRET_KEY=replace-with-a-long-random-value
ADMIN_PASSWORD=replace-with-a-strong-password
DATABASE_URL=sqlite:///./data/app.sqlite
DATA_DIR=./data
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=2048
PORT=8950
WEB_CONCURRENCY=2
WEB_THREADS=4

# Default deployment: existing private Tencent COS bucket.
STORAGE_PROVIDER=cos
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_PREFIX=duwuku/
COS_SECRET_ID=
COS_SECRET_KEY=
# Optional: only for temporary STS credentials; renew before expiry.
COS_SESSION_TOKEN=

# Optional legacy/local MinIO: set STORAGE_PROVIDER=minio.
# Local random credentials are generated in data/minio-dev.env.
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=software-portal-dev
MINIO_SECURE=false

# Aliyun SLS logging

ALIYUN_SLS_REGION=cn-hangzhou
ALIYUN_SLS_ENDPOINT=cn-hangzhou.log.aliyuncs.com
ALIYUN_SLS_PROJECT=zyb-telemetry
ALIYUN_SLS_LOGSTORE=events
ALIYUN_SLS_HISTORY_DAYS=3650
SOFTWARE_SAVINGS_RATES_JSON={"zipvid":0.5}
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=